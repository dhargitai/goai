# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys

# Required: Your OpenAI API key
OPENAI_API_KEY=sk-proj-your-key-here

# Optional: Model to use (default: gpt-6.1-sol)
# Any model from gpt-4o onwards works, e.g.:
# gpt-6.1-sol, gpt-5.5, gpt-5.4-mini, o4-mini, gpt-4.1, gpt-4o, gpt-4o-mini
OPENAI_MODEL=gpt-6.1-sol

# Example Service Configuration (for examples/api)
PORT=8080
